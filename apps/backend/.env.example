# ─── MultiversX Network ────────────────────────────────────────────────────────
MVX_API_URL=https://devnet-api.multiversx.com
MVX_NETWORK=devnet

# ─── Contract Addresses (devnet — update after each redeploy) ─────────────────
REGISTRY_CONTRACT_ADDRESS=erd1qqqqqqqqqqqqqpgqmyw7ln5jtwx6f4dtgqyq75rc9su9sgr92rlsagzntg
ESCROW_CONTRACT_ADDRESS=erd1qqqqqqqqqqqqqpgqqsp0dd9d9tl0c50w9ke9e22dre8hnk7t2rlsge3zhu
REPUTATION_CONTRACT_ADDRESS=erd1qqqqqqqqqqqqqpgq4xme7e4egxxsvfs2cc85nf8hzw5x73w02rlsquxpkh
TOKEN_CONTRACT_ADDRESS=erd1qqqqqqqqqqqqqpgqauyreu42l575acdjp3sqehnquzhkkss52rlskgk4yx
DAO_CONTRACT_ADDRESS=erd1qqqqqqqqqqqqqpgq38n4npajlnynk3u7jpykkcz7l0zj0xdd2rlscgp6me

# ─── Treasury & Arbiters (set after deploy) ───────────────────────────────────
# Treasury receives marketplace fees (from Registry + Escrow releaseEscrow)
TREASURY_ADDRESS=erd1YOUR_TREASURY_ADDRESS_HERE

# Multi-sig dispute arbiters (add up to 3 via addArbiter endpoint)
ARBITER_1_ADDRESS=erd1YOUR_ARBITER_1_HERE
ARBITER_2_ADDRESS=erd1YOUR_ARBITER_2_HERE
ARBITER_3_ADDRESS=erd1YOUR_ARBITER_3_HERE

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agentbazaar:password@localhost:5432/agentbazaar
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRY=24h

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Set to production for Railway / GCP deploys
# NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://agentbazaar.vercel.app

# ─── WalletConnect (frontend uses this) ───────────────────────────────────────
NEXT_PUBLIC_WC_PROJECT_ID=GET_FROM_cloud.walletconnect.com
